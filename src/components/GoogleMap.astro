---
import { company } from '../data/company';
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['map-card', className]} role="region" aria-label="Mapa lokalizacji HydroTech J&S">
  <iframe
    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2400!2d14.847574!3d52.678606!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNTLCsDQwJzQzLjAiTiAxNMKwNTAnNTEuMyJF!5e0!3m2!1spl!2spl!4v1700000000000!5m2!1spl!2spl"
    width="640"
    height="360"
    allowfullscreen
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    title="Mapa lokalizacji HydroTech J&S — Mościczki koło Witnicy"
  ></iframe>
  <div class="map-details">
    <span>{company.address}</span>
    <a class="text-link" href={company.maps} target="_blank" rel="noopener noreferrer">
      Otwórz w Google Maps <span aria-hidden="true">↗</span>
    </a>
  </div>
</div>
