---
import '../styles/global.css';
import { company, towns } from '../data/company';
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  article?: boolean;
}
const {
  title,
  description = 'Hydraulik w Witnicy i okolicach. Instalacje wodne, ogrzewanie podłogowe, kotłownie i uzdatnianie wody. HydroTech J&S — zadzwoń: 502 313 419.',
  ogImage = '/images/og-image.jpg',
  canonical,
  noindex = false,
  article = false,
} = Astro.props;
const pathname =
  Astro.url.pathname
    .replace(/\.html$/, '')
    .replace(/^\/index$/, '/')
    .replace(/\/$/, '') || '/';
const canonicalURL = new URL(canonical || pathname, Astro.site).toString();
const navigation = [
  { href: '/', label: 'Strona główna' },
  { href: '/uslugi', label: 'Usługi' },
  { href: '/blog', label: 'Realizacje i porady' },
  { href: '/kontakt', label: 'Kontakt' },
];
const isActive = (href: string) =>
  href === '/'
    ? pathname === '/'
    : pathname.startsWith(href) || (href === '/blog' && pathname.startsWith('/posts/'));
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'Plumber',
  '@id': new URL('/#firma', Astro.site).toString(),
  name: company.name,
  url: Astro.site?.toString(),
  image: new URL('/images/og-image.jpg', Astro.site).toString(),
  telephone: '+48502313419',
  email: company.email,
  description:
    'Instalacje wodne i grzewcze, kotłownie, uzdatnianie wody, hydrofornie i nawadnianie ogrodów. Witnica i okolice.',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Mościczki 34C',
    addressLocality: 'Witnica',
    postalCode: '66-460',
    addressRegion: 'Lubuskie',
    addressCountry: 'PL',
  },
  areaServed: towns.map((name) => ({ '@type': 'City', name })),
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '18:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '09:00',
      closes: '15:00',
    },
  ],
  sameAs: [company.facebook, company.maps],
};
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
    />
    <meta name="theme-color" content="#102e3c" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={new URL(ogImage || '/images/og-image.jpg', Astro.site).toString()}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL(ogImage || '/images/og-image.jpg', Astro.site).toString()}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="HydroTech J&S — realizacje i porady"
      href="/rss.xml"
    />
    <link rel="stylesheet" href="/fonts/fontawesome.min.css" />
    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Przejdź do treści
    </a>
    <div class="utility-bar">
      <div class="site-container utility-inner">
        <span>
          <span class="status-dot" aria-hidden="true"></span>Witnica i okolice · instalacje dla domu
          i firmy
        </span>
        <a href={company.phoneHref}>Porozmawiajmy: +48 {company.phone}</a>
      </div>
    </div>
    <header class="site-header">
      <div class="site-container header-inner">
        <a href="/" class="brand" aria-label="HydroTech J&S — strona główna">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 32 36" fill="none">
              <path
                d="M16 2S4 16 4 23a12 12 0 0 0 24 0C28 16 16 2 16 2Z"
                stroke="currentColor"
                stroke-width="2.5"
              />
              <path d="M10 22v7m12-7v7m-12-3h12" stroke="currentColor" stroke-width="2.5" />
            </svg>
          </span>
          <span>
            Hydro<span class="brand-tech">Tech</span>
            <small>J&S · INSTALACJE Z CHARAKTEREM</small>
          </span>
        </a>
        <nav class="desktop-nav" aria-label="Nawigacja główna">
          {navigation.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
        <a class="header-phone" href={company.phoneHref} aria-label={`Zadzwoń: ${company.phone}`}>
          <i class="fas fa-phone" aria-hidden="true"></i>
          <span>{company.phone}</span>
        </a>
        <button
          class="menu-toggle"
          id="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-navigation"
          aria-label="Otwórz menu"
        >
          <span></span>
          <span></span>
        </button>
      </div>
      <nav class="mobile-navigation" id="mobile-navigation" aria-label="Nawigacja mobilna" hidden>
        {navigation.map((item) => (
          <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
            <span aria-hidden="true">↗</span>
          </a>
        ))}
        <a href={company.phoneHref}>Zadzwoń: {company.phone}</a>
      </nav>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-container">
        <div class="footer-grid">
          <div>
            <a class="brand footer-brand" href="/">
              HydroTech <span>J&S</span>
            </a>
            <p>
              Woda. Ciepło. Spokój.
              <br />
              Instalacje dla Twojego domu.
            </p>
            <div class="social-links">
              <a
                href={company.facebook}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="HydroTech J&S na Facebooku"
              >
                <i class="fab fa-facebook-f" aria-hidden="true"></i>
              </a>
              <a
                href={company.maps}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Profil HydroTech J&S w Google"
              >
                <i class="fab fa-google" aria-hidden="true"></i>
              </a>
            </div>
          </div>
          <div>
            <h2>Na skróty</h2>
            {navigation.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))}
          </div>
          <div>
            <h2>Jesteśmy blisko</h2>
            <p>
              {company.address}
              <br />
              NIP: 599-253-80-52
            </p>
            <p>
              Pon.–pt. 8:00–18:00
              <br />
              Sobota 9:00–15:00
            </p>
          </div>
          <div>
            <h2>Masz pytanie? Zadzwoń.</h2>
            <a class="footer-phone" href={company.phoneHref}>
              {company.phone}
            </a>
            <a href={`mailto:${company.email}`}>{company.email}</a>
            <p>
              Termin i możliwość interwencji
              <br />
              ustalamy telefonicznie.
            </p>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} HydroTech J&S</span>
          <div>
            <a href="/polityka-prywatnosci">Polityka prywatności</a>
            <button type="button" data-cookie-settings>
              Ustawienia cookies
            </button>
          </div>
          <a href="https://github.com/MateuszSiuba" target="_blank" rel="noopener noreferrer">
            Wykonanie: Mateusz Siuba ↗
          </a>
        </div>
      </div>
    </footer>
    <div class="mobile-contact">
      <a href={company.phoneHref}>
        <i class="fas fa-phone" aria-hidden="true"></i>
        <span>
          Zadzwoń <strong>{company.phone}</strong>
        </span>
      </a>
      <a href="/kontakt#formularz">
        <i class="far fa-envelope" aria-hidden="true"></i>Napisz do nas
      </a>
    </div>
    <aside id="cookie-banner" class="cookie-banner" aria-label="Ustawienia analityki" hidden>
      <div>
        <strong>Twoja prywatność, Twój wybór.</strong>
        <p>
          Za Twoją zgodą użyjemy Google Analytics do pomiaru ruchu.{' '}
          <a href="/polityka-prywatnosci">Dowiedz się więcej</a>.
        </p>
      </div>
      <div class="cookie-actions">
        <button type="button" id="cookie-reject">
          Tylko niezbędne
        </button>
        <button type="button" id="cookie-accept">
          Zgadzam się na analitykę
        </button>
      </div>
    </aside>
    <script>
      const menuButton = document.getElementById('menu-toggle');
      const menu = document.getElementById('mobile-navigation');
      function closeMenu() {
        if (menu) menu.hidden = true;
        menuButton?.setAttribute('aria-expanded', 'false');
        menuButton?.setAttribute('aria-label', 'Otwórz menu');
      }
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') !== 'true';
        if (menu) menu.hidden = !open;
        menuButton.setAttribute('aria-expanded', String(open));
        menuButton.setAttribute('aria-label', open ? 'Zamknij menu' : 'Otwórz menu');
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu && !menu.hidden) {
          closeMenu();
          menuButton?.focus();
        }
      });
      menu?.addEventListener('click', (e) => {
        if ((e.target as Element).closest('a')) closeMenu();
      });
      matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
        if (e.matches) closeMenu();
      });
      const analyticsId = 'G-B3JM0G3ZD6';
      const consentKey = 'hydrotech-analytics-consent';
      const banner = document.getElementById('cookie-banner');
      const analyticsWindow = window as Window & {
        dataLayer?: unknown[];
        gtag?: (...args: unknown[]) => void;
        [key: string]: any;
      };
      let consentGranted = false;
      let analyticsLoaded = false;
      function loadAnalytics() {
        analyticsWindow['ga-disable-' + analyticsId] = false;
        if (analyticsLoaded) {
          analyticsWindow.gtag?.('consent', 'update', { analytics_storage: 'granted' });
          return;
        }
        analyticsLoaded = true;
        analyticsWindow.dataLayer = analyticsWindow.dataLayer || [];
        analyticsWindow.gtag = function () {
          analyticsWindow.dataLayer!.push(arguments);
        };
        analyticsWindow.gtag('consent', 'default', {
          analytics_storage: 'granted',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
        });
        analyticsWindow.gtag('js', new Date());
        analyticsWindow.gtag('config', analyticsId, {
          cookie_expires: 60 * 60 * 24 * 365,
          cookie_update: false,
        });
        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${analyticsId}`;
        document.head.appendChild(script);
      }
      function clearAnalyticsCookies() {
        const domains = ['', location.hostname, '.' + location.hostname];
        for (const cookie of document.cookie.split(';')) {
          const name = cookie.split('=')[0].trim();
          if (name === '_ga' || name.startsWith('_ga_'))
            for (const domain of domains)
              document.cookie = `${name}=; Max-Age=0; Path=/;${domain ? ` Domain=${domain};` : ''} SameSite=Lax`;
        }
      }
      function setConsent(accepted: boolean) {
        consentGranted = accepted;
        try {
          localStorage.setItem(
            consentKey,
            JSON.stringify({ accepted, expires: Date.now() + 365 * 86400000 }),
          );
          localStorage.removeItem('cookieAccepted');
        } catch {
          /* Choice still applies if storage is blocked. */
        }
        if (banner) banner.hidden = true;
        if (accepted) loadAnalytics();
        else {
          analyticsWindow['ga-disable-' + analyticsId] = true;
          analyticsWindow.gtag?.('consent', 'update', { analytics_storage: 'denied' });
          clearAnalyticsCookies();
        }
      }
      let storedConsent: { accepted: boolean; expires: number } | null = null;
      try {
        storedConsent = JSON.parse(localStorage.getItem(consentKey) || 'null');
      } catch {
        /* Ask again if unavailable. */
      }
      if (
        storedConsent &&
        typeof storedConsent.accepted === 'boolean' &&
        storedConsent.expires > Date.now()
      ) {
        consentGranted = storedConsent.accepted;
        if (consentGranted) loadAnalytics();
        else clearAnalyticsCookies();
      } else {
        clearAnalyticsCookies();
        if (banner) banner.hidden = false;
      }
      document.getElementById('cookie-accept')?.addEventListener('click', () => setConsent(true));
      document.getElementById('cookie-reject')?.addEventListener('click', () => setConsent(false));
      document.querySelectorAll('[data-cookie-settings]').forEach((button) =>
        button.addEventListener('click', () => {
          if (banner) banner.hidden = false;
          document.getElementById('cookie-reject')?.focus();
        }),
      );
      function track(name: string, params: Record<string, string> = {}) {
        if (consentGranted) analyticsWindow.gtag?.('event', name, params);
      }
      document.addEventListener('click', (e) => {
        const link = (e.target as Element).closest('a');
        if (!link) return;
        const href = link.getAttribute('href') || '';
        if (href.startsWith('tel:'))
          track('click_phone', {
            placement: link.closest('header')
              ? 'header'
              : link.closest('.mobile-contact')
                ? 'mobile_bar'
                : 'content',
          });
        else if (href.startsWith('mailto:')) track('click_email');
        else if (href.includes('wa.me/')) track('click_whatsapp');
      });
      document.addEventListener('hydrotech:form-success', () =>
        track('generate_lead', { method: 'contact_form' }),
      );
    </script>
  </body>
</html>
