---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import ProjectImage from '../../components/ProjectImage.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import { getCollection, render } from 'astro:content';
import { services } from '../../data/services';
import { imageBase } from '../../data/media';
export async function getStaticPaths() {
  return (await getCollection('posts', ({ data }) => data.status === 'published')).map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const slug = post.id.replace(/\.md$/, '');
const canonicalURL = new URL(`/posts/${slug}`, Astro.site).toString();
const posts = await getCollection('posts', ({ data }) => data.status === 'published');
const related = posts
  .filter((p) => p.id !== post.id)
  .map((p) => ({
    post: p,
    score:
      (p.data.category === post.data.category ? 10 : 0) +
      (p.data.tags || []).filter((t) => post.data.tags?.includes(t)).length * 3,
  }))
  .sort((a, b) => b.score - a.score || b.post.data.date.getTime() - a.post.data.date.getTime())
  .slice(0, 3)
  .map((p) => p.post);
const relatedServices = services
  .filter((service) =>
    service.keywords.some((keyword) =>
      `${slug} ${post.data.title} ${(post.data.tags || []).join(' ')}`
        .toLowerCase()
        .includes(keyword),
    ),
  )
  .slice(0, 3);
const featured =
  post.data.featured_image ||
  post.data.gallery?.find((item) => !/\.(mp4|mov|webm)$/i.test(item.image))?.image;
const base = imageBase(featured);
const comparisons = post.data.comparisons || [];
const comparedImages = new Set(
  comparisons.flatMap((comparison) => [comparison.before.image, comparison.after.image]),
);
const gallery = (post.data.gallery || []).filter((item) => !comparedImages.has(item.image));
const categoryLabels: Record<string, string> = {
  realizacje: 'Realizacja',
  porady: 'Porada',
  pytania: 'Pytania i odpowiedzi',
};
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.seo_description || post.data.description,
  ...(featured ? { image: new URL(featured, Astro.site).toString() } : {}),
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.lastmod || post.data.date).toISOString(),
  author: {
    '@type': 'Organization',
    name: post.data.author || 'HydroTech J&S',
    url: Astro.site?.toString(),
  },
  publisher: { '@id': new URL('/#firma', Astro.site).toString() },
  mainEntityOfPage: canonicalURL,
};
---

<Layout
  title={`${post.data.title} | HydroTech J&S`}
  description={post.data.seo_description || post.data.description}
  ogImage={base ? `${base}-1200.webp` : featured}
  canonical={canonicalURL}
  article
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article class="article-layout site-container">
    <Breadcrumbs
      items={[
        { label: 'Strona główna', href: '/' },
        { label: 'Realizacje i porady', href: '/blog' },
        { label: post.data.title },
      ]}
    />
    <header class="article-header">
      <p class="eyebrow">{categoryLabels[post.data.category || ''] || 'Z naszej praktyki'}</p>
      <h1>{post.data.title}</h1>
      <div class="article-meta">
        <time datetime={post.data.date.toISOString()}>
          {post.data.date.toLocaleDateString('pl-PL', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
            timeZone: 'Europe/Warsaw',
          })}
        </time>
        <span>HydroTech J&S</span>
      </div>
    </header>
    {comparisons.length > 0 && (
      <section class="article-comparisons" aria-labelledby="comparison-heading">
        <h2 id="comparison-heading">Przed i po wykonaniu prac</h2>
        {comparisons.map((comparison) => (
          <div class="article-comparison">
            <h3>{comparison.title}</h3>
            <BeforeAfter {...comparison} gallery />
          </div>
        ))}
      </section>
    )}
    {featured && comparisons.length === 0 && (
      <div class="article-featured">
        {base ? (
          <ProjectImage
            base={base}
            alt={post.data.title}
            eager
            sizes="(max-width: 900px) 100vw, 900px"
          />
        ) : (
          <img
            src={featured}
            alt={post.data.title}
            width="1200"
            height="900"
            fetchpriority="high"
          />
        )}
      </div>
    )}
    {post.data.features?.length && (
      <section class="article-scope">
        <h2>Zakres wykonanych prac</h2>
        <ul>
          {post.data.features.map((feature) => (
            <li>
              <i class="fas fa-check" aria-hidden="true"></i>
              {feature}
            </li>
          ))}
        </ul>
      </section>
    )}
    <div class="prose" id="post-content">
      <Content />
    </div>
    {gallery.length > 0 && (
      <section class="article-gallery">
        <h2>Zdjęcia i materiały z realizacji</h2>
        <div class="gallery-grid">
          {gallery.map((item) => {
            const video = /\.(mp4|mov|webm|ogg)$/i.test(item.image);
            const base = imageBase(item.image);
            return (
              <figure>
                {video ? (
                  <video
                    controls
                    preload="none"
                    playsinline
                    aria-label={item.alt}
                    poster={
                      item.image.endsWith('.mp4')
                        ? item.image.replace('.mp4', '-poster-768.webp')
                        : undefined
                    }
                  >
                    <source src={item.image} />
                    <a href={item.image}>Pobierz nagranie</a>
                  </video>
                ) : (
                  <a href={item.image} data-gallery-image aria-label={`Powiększ: ${item.alt}`}>
                    {base ? (
                      <ProjectImage
                        base={base}
                        alt={item.alt}
                        sizes="(max-width: 479px) 100vw, (max-width: 767px) 50vw, 300px"
                      />
                    ) : (
                      <img
                        src={item.image}
                        alt={item.alt}
                        width="640"
                        height="480"
                        loading="lazy"
                      />
                    )}
                  </a>
                )}
                <figcaption>{item.alt}</figcaption>
              </figure>
            );
          })}
        </div>
        {gallery.some((item) => /\.(mp4|mov|webm|ogg)$/i.test(item.image)) && (
          <p class="area-note">
            Nagranie się nie odtwarza? Otwórz je bezpośrednio:{' '}
            {gallery
              .filter((item) => /\.(mp4|mov|webm|ogg)$/i.test(item.image))
              .map((item) => (
                <a class="text-link" href={item.image}>
                  {item.alt} ↗
                </a>
              ))}
          </p>
        )}
      </section>
    )}
    {relatedServices.length > 0 && (
      <section class="article-services">
        <h2>Potrzebujesz podobnych prac?</h2>
        <div>
          {relatedServices.map((service) => (
            <a href={`/uslugi/${service.slug}`}>{service.short} ↗</a>
          ))}
        </div>
      </section>
    )}
    <div class="article-share">
      <a class="text-link" href="/blog">
        ← Wróć do realizacji i porad
      </a>
      <a
        class="button button-outline"
        href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonicalURL)}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        <i class="fab fa-facebook-f" aria-hidden="true"></i>Udostępnij
      </a>
      <button class="button button-outline" type="button" id="copy-link">
        Kopiuj link
      </button>
      <span id="copy-status" role="status" aria-live="polite"></span>
    </div>
    {related.length > 0 && (
      <section class="article-related">
        <h2>Może Cię też zainteresować</h2>
        <div class="post-grid">
          {related.map((p) => (
            <PostCard
              title={p.data.title}
              description={p.data.description}
              date={p.data.date}
              slug={p.id.replace(/\.md$/, '')}
              category={p.data.category}
              featuredImage={p.data.featured_image}
              gallery={p.data.gallery}
            />
          ))}
        </div>
      </section>
    )}
  </article>
  <ContactCTA />
  <dialog id="gallery-dialog" class="gallery-dialog" aria-label="Podgląd zdjęć">
    <div class="gallery-toolbar">
      <span id="gallery-counter" aria-live="polite"></span>
      <button type="button" id="gallery-close" aria-label="Zamknij podgląd">
        ×
      </button>
    </div>
    <button type="button" class="gallery-prev" aria-label="Poprzednie zdjęcie">
      ←
    </button>
    <figure>
      <img id="gallery-image" alt="" />
      <figcaption id="gallery-caption"></figcaption>
    </figure>
    <button type="button" class="gallery-next" aria-label="Następne zdjęcie">
      →
    </button>
  </dialog>
  <script>
    const dialog = document.getElementById('gallery-dialog') as HTMLDialogElement;
    const image = document.getElementById('gallery-image') as HTMLImageElement;
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-gallery-image]'));
    let current = 0;
    function show(index: number) {
      current = (index + links.length) % links.length;
      const link = links[current];
      if (!link) return;
      image.src = link.href;
      image.alt = link.querySelector('img')?.alt || '';
      document.getElementById('gallery-counter')!.textContent = `${current + 1} / ${links.length}`;
      document.getElementById('gallery-caption')!.textContent = image.alt;
    }
    links.forEach((link, index) =>
      link.addEventListener('click', (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || !dialog.showModal) return;
        event.preventDefault();
        show(index);
        dialog.showModal();
      }),
    );
    document.getElementById('gallery-close')?.addEventListener('click', () => dialog.close());
    dialog?.querySelector('.gallery-prev')?.addEventListener('click', () => show(current - 1));
    dialog?.querySelector('.gallery-next')?.addEventListener('click', () => show(current + 1));
    dialog?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(current - 1);
      }
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(current + 1);
      }
    });
    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    document.getElementById('copy-link')?.addEventListener('click', async () => {
      const status = document.getElementById('copy-status');
      try {
        const url =
          document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.href || location.href;
        await navigator.clipboard.writeText(url);
        if (status) status.textContent = 'Link skopiowany.';
      } catch {
        if (status) status.textContent = 'Skopiuj adres z paska przeglądarki.';
      }
    });
  </script>
</Layout>
