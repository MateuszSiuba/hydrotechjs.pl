---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts', ({ data }) => data.status === 'published')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const categories = [
  { id: 'wszystkie', label: 'Wszystkie' },
  { id: 'realizacje', label: 'Realizacje' },
  { id: 'porady', label: 'Porady' },
  { id: 'pytania', label: 'Pytania' },
];
---

<Layout
  title="Realizacje i porady hydrauliczne | HydroTech J&S Witnica"
  description="Zobacz nasze kotłownie, ogrzewanie podłogowe i instalacje wodne. Zdjęcia realizacji HydroTech J&S oraz praktyczne porady z Witnicy i okolic."
>
  <section class="page-hero">
    <div class="site-container">
      <Breadcrumbs
        items={[{ label: 'Strona główna', href: '/' }, { label: 'Realizacje i porady' }]}
      />
      <p class="eyebrow">Z naszej praktyki</p>
      <h1>
        Tak pracujemy.
        <br />
        Tym się dzielimy.
      </h1>
      <p class="lead">
        Prawdziwe realizacje, zdjęcia z montażu i odpowiedzi na pytania o instalacje. Zajrzyj za
        kulisy naszej pracy.
      </p>
    </div>
  </section>
  <section class="section-space">
    <div class="site-container">
      <div class="blog-tools" id="blog-tools" hidden>
        <div class="blog-search">
          <label for="search-input" class="sr-only">
            Szukaj w realizacjach i poradach
          </label>
          <input id="search-input" type="search" placeholder="Szukaj, np. kotłownia, bojler…" />
          <button id="search-clear" type="button" aria-label="Wyczyść wyszukiwanie" hidden>
            ×
          </button>
        </div>
        <div class="blog-filters" id="filters" role="group" aria-label="Kategorie wpisów">
          {categories.map((category) => (
            <button
              type="button"
              data-category={category.id}
              aria-pressed={category.id === 'wszystkie' ? 'true' : 'false'}
            >
              {category.label}
            </button>
          ))}
        </div>
      </div>
      <p id="search-count" class="text-sm text-gray-600 mb-6" aria-live="polite" role="status"></p>
      <div class="post-grid" id="posts-grid">
        {posts.map((post) => (
          <div
            data-post-category={post.data.category || 'inne'}
            data-post-search={`${post.data.title} ${post.data.description} ${(post.data.tags || []).join(' ')}`}
          >
            <PostCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              slug={post.id.replace(/\.md$/, '')}
              category={post.data.category}
              featuredImage={post.data.featured_image}
              gallery={post.data.gallery}
            />
          </div>
        ))}
      </div>
      <p id="no-results" class="py-12 text-center text-gray-600" hidden>
        Nie znaleziono wpisów. Zmień hasło lub wybierz inną kategorię.
      </p>
    </div>
  </section>
  <ContactCTA />
  <script>
    const grid = document.getElementById('posts-grid');
    const search = document.getElementById('search-input') as HTMLInputElement;
    const clear = document.getElementById('search-clear');
    const filters = document.getElementById('filters');
    const normalize = (text: string) =>
      text
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/ł/g, 'l');
    const params = new URLSearchParams(location.search);
    let category = ['realizacje', 'porady', 'pytania'].includes(params.get('category') || '')
      ? params.get('category')!
      : 'wszystkie';
    if (search) search.value = params.get('q') || '';
    document.getElementById('blog-tools')?.removeAttribute('hidden');
    function filterPosts(updateURL = true) {
      const query = normalize(search?.value.trim() || '');
      let count = 0;
      grid?.querySelectorAll<HTMLElement>('[data-post-category]').forEach((post) => {
        const matches =
          (category === 'wszystkie' || post.dataset.postCategory === category) &&
          normalize(post.dataset.postSearch || '').includes(query);
        post.hidden = !matches;
        if (matches) count++;
      });
      filters
        ?.querySelectorAll<HTMLButtonElement>('button')
        .forEach((button) =>
          button.setAttribute('aria-pressed', String(button.dataset.category === category)),
        );
      if (clear) clear.hidden = !search?.value;
      const empty = document.getElementById('no-results');
      if (empty) empty.hidden = count > 0;
      const counter = document.getElementById('search-count');
      if (counter)
        counter.textContent = query || category !== 'wszystkie' ? `Liczba wyników: ${count}` : '';
      if (updateURL) {
        const url = new URL(location.href);
        if (category === 'wszystkie') url.searchParams.delete('category');
        else url.searchParams.set('category', category);
        if (search?.value.trim()) url.searchParams.set('q', search.value.trim());
        else url.searchParams.delete('q');
        history.replaceState(null, '', url);
      }
    }
    filters?.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('button[data-category]');
      if (button) {
        category = button.dataset.category || 'wszystkie';
        filterPosts();
      }
    });
    search?.addEventListener('input', () => filterPosts());
    clear?.addEventListener('click', () => {
      search.value = '';
      filterPosts();
      search.focus();
    });
    filterPosts(false);
  </script>
</Layout>
