---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import GoogleMap from '../components/GoogleMap.astro';
import { company, towns } from '../data/company';
import { services } from '../data/services';
---

<Layout
  title="Kontakt — hydraulik Witnica, tel. 502 313 419 | HydroTech J&S"
  description="Zadzwoń do HydroTech J&S: 502 313 419. Instalacje i naprawy w Witnicy i okolicach. Napisz, czego potrzebujesz, i zapytaj o termin oraz wycenę."
>
  <section class="page-hero">
    <div class="site-container">
      <Breadcrumbs items={[{ label: 'Strona główna', href: '/' }, { label: 'Kontakt' }]} />
      <p class="eyebrow">Zacznijmy od rozmowy</p>
      <h1>
        Twoja instalacja.
        <br />
        Nasza wspólna rozmowa.
      </h1>
      <p class="lead">
        Budowa, remont lub awaria? Powiedz, czego potrzebujesz. Ustalimy, jak możemy pomóc.
      </p>
    </div>
  </section>
  <section class="section-space">
    <div class="site-container contact-layout">
      <div>
        <p class="eyebrow">Najszybciej przez telefon</p>
        <a class="contact-big-phone" href={company.phoneHref}>
          {company.phone} <span aria-hidden="true">↗</span>
        </a>
        <p class="section-intro">
          W sprawie awarii zadzwoń. Możliwość interwencji i termin przyjazdu potwierdzamy podczas
          rozmowy.
        </p>
        <dl class="contact-details">
          <div>
            <dt>E-mail</dt>
            <dd>
              <a href={`mailto:${company.email}`}>{company.email}</a>
            </dd>
          </div>
          <div>
            <dt>Adres firmy</dt>
            <dd>
              {company.address}
              <br />
              NIP: 599-253-80-52
            </dd>
          </div>
          <div>
            <dt>Godziny pracy</dt>
            <dd>
              Poniedziałek–piątek: 8:00–18:00
              <br />
              Sobota: 9:00–15:00
            </dd>
          </div>
        </dl>
        <div class="contact-channels">
          <a
            class="button button-outline"
            href="https://wa.me/48502313419"
            target="_blank"
            rel="noopener noreferrer"
          >
            <i class="fab fa-whatsapp" aria-hidden="true"></i>WhatsApp
          </a>
          <a
            class="button button-outline"
            href={company.facebook}
            target="_blank"
            rel="noopener noreferrer"
          >
            <i class="fab fa-facebook-f" aria-hidden="true"></i>Facebook
          </a>
        </div>
        <div style="margin-top:30px">
          <GoogleMap />
        </div>
      </div>
      <div class="form-panel" id="formularz">
        <h2>Opisz, co planujesz.</h2>
        <p>
          Podaj miejscowość i kilka szczegółów. Odpowiemy na podany adres e-mail. Pola oznaczone *
          są wymagane.
        </p>
        <form action="https://formspree.io/f/xanykwzv" method="POST" id="contact-form">
          <div class="form-grid">
            <div class="form-field">
              <label for="name">Imię *</label>
              <input id="name" name="name" autocomplete="given-name" required maxlength="100" />
            </div>
            <div class="form-field">
              <label for="phone">
                Telefon <span>(opcjonalnie)</span>
              </label>
              <input type="tel" id="phone" name="phone" autocomplete="tel" maxlength="30" />
            </div>
            <div class="form-field full">
              <label for="email">E-mail *</label>
              <input
                type="email"
                id="email"
                name="email"
                autocomplete="email"
                required
                maxlength="254"
              />
            </div>
            <div class="form-field">
              <label for="town">Miejscowość *</label>
              <input id="town" name="town" autocomplete="address-level2" required maxlength="120" />
            </div>
            <div class="form-field">
              <label for="service">Rodzaj prac</label>
              <select id="service" name="service">
                <option value="Nie określono">Wybierz usługę</option>
                {services.map((service) => (
                  <option>{service.short}</option>
                ))}
                <option>Inne / chcę porozmawiać</option>
              </select>
            </div>
            <div class="form-field full">
              <label for="message">W czym możemy pomóc? *</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                minlength="10"
                maxlength="5000"
                placeholder="Napisz, co trzeba wykonać i na jakim etapie są prace."
              ></textarea>
            </div>
          </div>
          <div class="honeypot" aria-hidden="true">
            <label for="website">Zostaw to pole puste</label>
            <input id="website" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="_subject" value="Zapytanie ze strony HydroTech J&S" />
          <p class="form-privacy">
            Dane z formularza wykorzystamy do odpowiedzi na Twoje zapytanie. Administratorem jest
            HydroTech J&S. Szczegóły znajdziesz w{' '}
            <a href="/polityka-prywatnosci">polityce prywatności</a>.
          </p>
          <button type="submit" class="button button-dark">
            Wyślij zapytanie <span aria-hidden="true">↗</span>
          </button>
        </form>
        <div
          id="form-status"
          class="form-status"
          role="status"
          aria-live="polite"
          tabindex="-1"
          hidden
        ></div>
      </div>
    </div>
  </section>
  <section class="section-space area-section">
    <div class="site-container area-grid">
      <div>
        <p class="eyebrow">Działamy lokalnie</p>
        <h2 class="section-title">Witnica i okolice.</h2>
        <p class="section-intro" style="margin-top:20px">
          Możliwość wykonania prac oraz warunki dojazdu ustalamy przy rozmowie o Twoim zleceniu.
        </p>
      </div>
      <div class="town-list">
        {towns.map((town) => (
          <span>{town}</span>
        ))}
      </div>
    </div>
  </section>
  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const status = document.getElementById('form-status');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      if (button.disabled || !form.reportValidity()) return;
      button.disabled = true;
      button.textContent = 'Wysyłanie…';
      form.setAttribute('aria-busy', 'true');
      if (status) status.hidden = true;
      const controller = new AbortController();
      const timeout = window.setTimeout(() => controller.abort(), 20000);
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
          signal: controller.signal,
        });
        if (!response.ok) throw new Error('Submission failed');
        if (status) {
          status.hidden = false;
          status.className = 'form-status success';
          status.textContent =
            'Dziękujemy! Wiadomość została wysłana. Odpowiemy na podany adres e-mail.';
          status.focus();
        }
        form.reset();
        document.dispatchEvent(new CustomEvent('hydrotech:form-success'));
      } catch {
        if (status) {
          status.hidden = false;
          status.className = 'form-status error';
          status.textContent =
            'Nie udało się potwierdzić wysłania wiadomości. Twoje dane pozostają w formularzu. Spróbuj ponownie lub zadzwoń: 502 313 419.';
          status.focus();
        }
      } finally {
        clearTimeout(timeout);
        button.disabled = false;
        button.textContent = 'Wyślij zapytanie ↗';
        form.removeAttribute('aria-busy');
      }
    });
  </script>
</Layout>
