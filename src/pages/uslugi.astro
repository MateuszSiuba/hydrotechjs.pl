---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { services } from '../data/services';
---

<Layout
  title="Usługi hydrauliczne w Witnicy i okolicach | HydroTech J&S"
  description="Instalacje wodne i kanalizacyjne, ogrzewanie podłogowe, kotłownie, uzdatnianie wody, hydrofornie i nawadnianie. Poznaj ofertę HydroTech J&S."
>
  <section class="page-hero">
    <div class="site-container">
      <Breadcrumbs items={[{ label: 'Strona główna', href: '/' }, { label: 'Usługi' }]} />
      <p class="eyebrow">Od montażu po modernizację</p>
      <h1>
        Instalacje, które tworzą
        <br />
        komfort Twojego domu.
      </h1>
      <p class="lead">
        Woda, ogrzewanie i wszystko, co je łączy. Zobacz, w czym możemy Ci pomóc w Witnicy i
        okolicach.
      </p>
    </div>
  </section>
  <section class="section-space">
    <div class="site-container">
      <div class="services-grid">
        {services.map((service, i) => (
          <article class="service-card">
            <div class="service-top">
              <i class={`fas ${service.icon}`} aria-hidden="true"></i>
              <span>0{i + 1}</span>
            </div>
            <h2 class="text-xl font-semibold mb-3">
              <a href={`/uslugi/${service.slug}`}>{service.title}</a>
            </h2>
            <p>{service.description}</p>
            <ul>
              {service.features.slice(0, 3).map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
            <a class="text-link" href={`/uslugi/${service.slug}`}>
              Zakres prac i realizacje <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
  <ContactCTA />
</Layout>
