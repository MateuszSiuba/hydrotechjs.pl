---
import Layout from '../layouts/Layout.astro';
import ProjectImage from '../components/ProjectImage.astro';
import ContactCTA from '../components/ContactCTA.astro';
import GoogleMap from '../components/GoogleMap.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import { getCollection } from 'astro:content';
import { company, towns } from '../data/company';
import { services } from '../data/services';
import { imageBase } from '../data/media';
const publishedPosts = await getCollection('posts', ({ data }) => data.status === 'published');
const comparisonPost = publishedPosts.find(
  (post) => post.id === '2025-04-28-modernizacja-hydroforni',
);
const comparison = comparisonPost?.data.comparisons?.[0];
const projects = publishedPosts
  .filter((post) => post.data.category === 'realizacje')
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
  .map((post) => {
    const source =
      post.data.featured_image ||
      post.data.gallery?.find((item) => !/\.(mp4|mov|webm|ogg)$/i.test(item.image))?.image;
    return {
      title: post.data.title,
      type: post.data.date.toLocaleDateString('pl-PL', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        timeZone: 'Europe/Warsaw',
      }),
      image: imageBase(source),
      source,
      slug: post.id,
    };
  });
const faqs = [
  {
    q: 'Gdzie wykonujecie instalacje?',
    a: 'Działamy w Witnicy i okolicach, między innymi w Gorzowie Wielkopolskim, Kostrzynie nad Odrą, Dębnie i Bogdańcu. Zadzwoń i podaj miejscowość — potwierdzimy możliwość oraz warunki dojazdu.',
  },
  {
    q: 'Jak umówić wycenę?',
    a: 'Zadzwoń pod numer 502 313 419 lub wyślij wiadomość przez formularz. Opisz planowane prace i podaj miejscowość. Zdjęcia instalacji oraz metraż pomogą wstępnie ustalić zakres. Przy większych pracach umawiamy oględziny.',
  },
  {
    q: 'Czy zajmujecie się naprawą awarii?',
    a: 'Tak, pomagamy przy awariach instalacji wodnych i grzewczych. W pilnej sprawie zadzwoń. Dostępność i możliwy termin przyjazdu potwierdzamy podczas rozmowy.',
  },
  {
    q: 'Czy można zobaczyć wcześniejsze realizacje?',
    a: 'Tak. W dziale „Realizacje i porady” pokazujemy zdjęcia oraz opisy wykonanych instalacji: kotłowni, ogrzewania podłogowego, hydroforni i innych prac.',
  },
];
---

<Layout title="Hydraulik Witnica — instalacje wodne i ogrzewanie | HydroTech J&S">
  <section class="home-hero">
    <div class="site-container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Hydraulik · Witnica i okolice</p>
        <h1>
          Woda. Ciepło.
          <br />
          <em>Spokój w domu.</em>
        </h1>
        <p>
          Od instalacji w nowym domu po wymianę kotłowni. Zajmiemy się hydrauliką i ogrzewaniem,
          żebyś mógł zająć się tym, co dla Ciebie ważne.
        </p>
        <div class="hero-actions">
          <a href={company.phoneHref} class="button button-dark">
            <i class="fas fa-phone" aria-hidden="true"></i>Zadzwoń: {company.phone}
          </a>
          <a href="/uslugi" class="text-link">
            Poznaj nasze usługi <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="hero-note">
          <i class="fas fa-location-dot" aria-hidden="true"></i>Lokalna firma. Kontakt bezpośrednio
          z wykonawcą.
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-photo">
          <ProjectImage
            base="/attachments/kociol1"
            alt="Nasza realizacja: kocioł Stalmark i miedziana instalacja kotłowni"
            eager
          />
        </div>
        <div class="hero-stamp" aria-hidden="true">
          <span>Woda i ciepło</span>
          <i class="fas fa-droplet"></i>
          <span>HydroTech J&S</span>
        </div>
        <a class="hero-caption" href="/posts/2026-01-04-kotlownia-kociol-stalmark-plus-odzelaziacz">
          <small>Tak pracujemy</small>
          <p>
            Prawdziwe instalacje.
            <br />
            Nasze wykonanie. ↗
          </p>
        </a>
      </div>
    </div>
  </section>
  <div class="trust-strip">
    <div class="site-container trust-inner">
      {[
        { icon: 'fa-house', text: 'Dla domu i firmy' },
        { icon: 'fa-screwdriver-wrench', text: 'Montaż i modernizacja' },
        { icon: 'fa-comments', text: 'Jasno ustalony zakres' },
        { icon: 'fa-location-dot', text: 'Witnica i okolice' },
      ].map((item) => (
        <div class="trust-item">
          <i class={`fas ${item.icon}`} aria-hidden="true"></i>
          <span>{item.text}</span>
        </div>
      ))}
    </div>
  </div>
  <section class="section-space" id="uslugi">
    <div class="site-container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Co możemy dla Ciebie zrobić</p>
          <h2>
            Dobry dom zaczyna się
            <br />
            od dobrej instalacji.
          </h2>
        </div>
        <p>
          Budujesz, remontujesz, a może coś przestało działać? Dobierzemy zakres prac do Twojej
          sytuacji.
        </p>
      </div>
      <div class="services-grid">
        {services.slice(0, 6).map((service, i) => (
          <article class="service-card">
            <div class="service-top">
              <i class={`fas ${service.icon}`} aria-hidden="true"></i>
              <span>0{i + 1}</span>
            </div>
            <h3>
              <a href={`/uslugi/${service.slug}`}>{service.short}</a>
            </h3>
            <p>{service.description}</p>
            <a class="text-link" href={`/uslugi/${service.slug}`}>
              Poznaj usługę <span aria-hidden="true">↗</span>
            </a>
          </article>
        ))}
      </div>
      <div class="emergency-strip">
        <i class="fas fa-wrench" aria-hidden="true"></i>
        <div>
          <strong>Coś przecieka? Ogrzewanie nie działa?</strong>
          <p>W pilnej sprawie zadzwoń. Ustalimy możliwość i termin interwencji.</p>
          <a class="text-link" href="/uslugi/awarie-hydrauliczne">
            Pomoc przy awarii <span aria-hidden="true">↗</span>
          </a>
        </div>
        <a class="button button-dark" href={company.phoneHref}>
          {company.phone} <i class="fas fa-phone" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </section>
  <section class="section-space projects-section" id="realizacje">
    <div class="site-container">
      <div class="section-heading">
        <div>
          <p class="eyebrow light">Zobacz efekty naszej pracy</p>
          <h2>
            Mniej obietnic.
            <br />
            Więcej konkretów.
          </h2>
        </div>
        <a class="text-link light" href="/blog?category=realizacje">
          Wszystkie realizacje <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <a href={`/posts/${project.slug}`} class="project-card">
            <div class="project-img">
              {project.image ? (
                <ProjectImage
                  base={project.image}
                  alt={project.title}
                  sizes="(max-width: 479px) 100vw, (max-width: 1023px) 50vw, 33vw"
                />
              ) : project.source ? (
                <img
                  src={project.source}
                  alt={project.title}
                  width="640"
                  height="480"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <i class="fas fa-wrench" aria-hidden="true"></i>
              )}
            </div>
            <div class="project-meta">
              <span>{project.type}</span>
              <span aria-hidden="true">↗</span>
            </div>
            <h3>{project.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>
  {comparison && comparisonPost && (
    <section class="section-space home-comparison" aria-labelledby="home-comparison-heading">
      <div class="site-container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Ta sama instalacja. Dwa etapy.</p>
            <h2 id="home-comparison-heading">
              Różnicę widać.
              <br />
              Przed i po naszej pracy.
            </h2>
          </div>
          <p>
            W tej hydroforni wymieniliśmy rury i armaturę. Zobacz stan instalacji przed modernizacją
            i efekt wykonanych prac.
          </p>
        </div>
        <BeforeAfter {...comparison} />
        <a class="text-link comparison-more" href={`/posts/${comparisonPost.id}`}>
          Zobacz całą realizację i nagrania <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  )}
  <section class="section-space" id="o-nas">
    <div class="site-container process-grid">
      <div>
        <p class="eyebrow">HydroTech J&S</p>
        <h2 class="section-title">
          Po ludzku.
          <br />
          Od pierwszej rozmowy.
        </h2>
        <p class="section-intro" style="margin-top:22px">
          Jesteśmy firmą z Mościczek koło Witnicy. Wykonujemy instalacje wodne i grzewcze,
          modernizujemy kotłownie i pomagamy przy naprawach. Przed pracą ustalamy, co trzeba zrobić.
        </p>
        <a class="text-link" href={company.maps} target="_blank" rel="noopener noreferrer">
          Poznaj opinie klientów w Google <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="steps">
        {[
          {
            title: 'Zaczynamy od rozmowy',
            text: 'Powiedz, czego potrzebujesz i gdzie. Zdjęcia, metraż lub projekt pomogą nam lepiej poznać temat.',
          },
          {
            title: 'Ustalamy zakres i wycenę',
            text: 'Omawiamy rozwiązanie, materiały i termin. Przy większych pracach umawiamy oględziny na miejscu.',
          },
          {
            title: 'Wykonujemy i sprawdzamy',
            text: 'Montujemy instalację, sprawdzamy wykonane połączenia i omawiamy z Tobą rezultat prac.',
          },
        ].map((step, i) => (
          <div class="step">
            <span>0{i + 1} /</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="section-space area-section">
    <div class="site-container area-grid">
      <div>
        <p class="eyebrow">Działamy lokalnie</p>
        <h2 class="section-title">
          Z Witnicy.
          <br />
          Do Twojego domu.
        </h2>
        <p class="section-intro" style="margin-top:20px">
          Obsługujemy Witnicę i pobliskie miejscowości. Planujesz instalację lub modernizację?
          Porozmawiajmy o dojeździe i terminie.
        </p>
        <a class="text-link" href="/kontakt">
          Sprawdź dane kontaktowe <span aria-hidden="true">↗</span>
        </a>
        <div class="town-list area-towns">
          {towns.map((town) => (
            <span>{town}</span>
          ))}
        </div>
        <p class="area-note">
          Twojej miejscowości nie ma na liście? Zadzwoń — ustalimy możliwość wykonania prac. Warunki
          dojazdu potwierdzamy przy wycenie.
        </p>
      </div>
      <GoogleMap />
    </div>
  </section>
  <section class="section-space">
    <div class="site-container faq-grid">
      <div>
        <p class="eyebrow">Warto wiedzieć</p>
        <h2 class="section-title">Zanim zaczniemy.</h2>
        <p class="section-intro" style="margin-top:20px">
          Kilka odpowiedzi, które ułatwią zaplanowanie prac. Resztę omówimy przez telefon.
        </p>
      </div>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <ContactCTA />
</Layout>
